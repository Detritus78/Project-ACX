# Copy to live.env / preview.env (acx.sh init does this and fills in passwords).
# The real files are gitignored: they hold passwords.

ACX_INSTANCE=live
ACX_ENV_FILE=live.env
ACX_DATA_DIR=/home/jj/acx-data/live
ACX_DAT_DIR=/mnt/games/AC-Data
ACX_GAME_PORT=9000
ACX_GAME_PORT_2=9001
ACX_DB_PORT=3306

PUID=1000
PGID=1000
TZ=America/New_York

# MySQL container. MYSQL_DATABASE=ace% grants the user every ace_* database.
MYSQL_ROOT_HOST=%
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=acx
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ace%

# First-run setup of ACE (writes Config.js into ACX_DATA_DIR/Config).
ACE_WORLD_NAME=Project ACX
ACE_DAT_FILES_DIRECTORY=/ace/Dats
ACE_SQL_AUTH_DATABASE_NAME=ace_auth
ACE_SQL_AUTH_DATABASE_PORT=3306
ACE_SQL_SHARD_DATABASE_NAME=ace_shard
ACE_SQL_SHARD_DATABASE_PORT=3306
ACE_SQL_WORLD_DATABASE_NAME=ace_world
ACE_SQL_WORLD_DATABASE_PORT=3306
ACE_SQL_INITIALIZE_DATABASES=true
ACE_SQL_DOWNLOAD_LATEST_WORLD_RELEASE=true
ACE_NONINTERACTIVE_SETUP=true
